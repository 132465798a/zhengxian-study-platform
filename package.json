{
  "name": "zhengxian-study-platform",
  "productName": "正贤学习平台",
  "version": "0.1.0",
  "description": "正贤学习平台 · 1-6 年级语文数学英语练习与考试",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/ensure-bank.cjs && node scripts/ensure-asr.cjs && electron-vite dev",
    "dev:debug": "node scripts/ensure-bank.cjs && node scripts/ensure-asr.cjs && electron-vite dev -- --remote-debugging-port=9222",
    "build": "node scripts/ensure-bank.cjs && node scripts/ensure-asr.cjs && electron-vite build",
    "asr:fetch": "node scripts/ensure-asr.cjs",
    "audio:build": "esbuild scripts/build-audio.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:msedge-tts --outfile=.tmp/build-audio.cjs && node scripts/run-electron-node.cjs .tmp/build-audio.cjs",
    "start": "electron-vite preview",
    "seed:build": "esbuild scripts/build-bank.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:electron --outfile=.tmp/build-bank.cjs && node scripts/run-electron-node.cjs .tmp/build-bank.cjs",
    "seed:difficulty": "esbuild scripts/reclassify-bank.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:electron --outfile=.tmp/reclassify-bank.cjs && node scripts/run-electron-node.cjs .tmp/reclassify-bank.cjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/ensure-bank.cjs && node scripts/run-electron-node.cjs scripts/check-bank.cjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"electron/**/*.ts\" \"shared/**/*.ts\"",
    "dist": "node scripts/ensure-bank.cjs && node scripts/ensure-asr.cjs --required && npm run audio:build && electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "cnchar": "^3.2.6",
    "cnchar-code": "^3.2.6",
    "cnchar-explain": "^3.2.6",
    "cnchar-idiom": "^3.2.6",
    "cnchar-info": "^3.2.6",
    "cnchar-input": "^3.2.6",
    "cnchar-order": "^3.2.6",
    "cnchar-poly": "^3.2.6",
    "cnchar-radical": "^3.2.6",
    "cnchar-trad": "^3.2.6",
    "cnchar-voice": "^3.2.6",
    "cnchar-words": "^3.2.6",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "interactjs": "^1.10.28",
    "msedge-tts": "^2.1.0",
    "node-emoji": "^2.2.0",
    "pdfjs-dist": "^4.10.38",
    "sherpa-onnx-node": "^1.13.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^10.0.1",
    "@primevue/themes": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "katex": "^0.16.20",
    "papaparse": "^5.5.2",
    "pinia": "^3.0.1",
    "prettier": "^3.9.10",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.11",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  }
}
